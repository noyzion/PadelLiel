# Copy to .env.local and fill in values from your Supabase project
# (Project Settings -> API). NEVER commit real values.

# Public (safe for the browser): project URL + publishable (anon) key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Legacy alternative name for the key above (only one of the two is needed):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of the deployed app. Used for auth e-mail links and the WhatsApp message.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The coach's WhatsApp number (optional). A trainee who forgot her password is sent here; the coach then resets it
# from the trainee's page in the admin area. Without it the "forgot password" page only says to contact the coach.
# NEXT_PUBLIC_COACH_WHATSAPP=050-123-4567

# Annual community-events import (/admin/events/import). The dry-run is always available; WRITING is refused
# unless this is set to 1 on the server. Leave it unset except for the moment an admin has approved the import.
# ALLOW_EVENT_IMPORT=1

# NOTE: the Supabase service_role key is intentionally NOT used by this app.
# All privileged operations go through SECURITY DEFINER SQL functions checked against the logged-in admin.

# Web Push + notification dispatcher (optional). Without these, the in-app notification center still works;
# phone Push does not. Generate values with: node scripts/notification-setup.mjs
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# NOTIFICATION_DISPATCH_SECRET=   # at least 32 characters. Never a NEXT_PUBLIC_ variable.
